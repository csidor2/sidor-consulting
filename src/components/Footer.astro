---
const year = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-400">
  <div class="max-w-6xl mx-auto px-6 py-12">
    <div class="flex flex-col md:flex-row justify-between items-start gap-8">
      <div>
        <a href="/" class="text-xl font-bold text-white">
          Sidor<span class="text-blue-400">.</span>
        </a>
        <p class="mt-2 text-sm max-w-xs leading-relaxed">
          Helping early-stage companies scale their sales and go-to-market operations.
        </p>
      </div>

      <div class="flex gap-12">
        <div>
          <h4 class="text-sm font-semibold text-white mb-3">Pages</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
            <li><a href="/about" class="hover:text-white transition-colors">About</a></li>
            <li><a href="/services" class="hover:text-white transition-colors">Services</a></li>
            <li><a href="/contact" class="hover:text-white transition-colors">Contact</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-sm font-semibold text-white mb-3">Contact</h4>
          <ul class="space-y-2 text-sm">
            <li>
              <a href="mailto:csidor2@gmail.com" class="hover:text-white transition-colors">
                csidor2@gmail.com
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="border-t border-slate-800 mt-10 pt-6 text-sm text-center md:text-left">
      &copy; {year} Sidor Consulting Services. All rights reserved.
    </div>
  </div>
</footer>
