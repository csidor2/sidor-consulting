---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Home">
  <Nav />

  <!-- Hero -->
  <section class="relative bg-slate-900 text-white overflow-hidden pt-32 pb-24">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_rgba(37,99,235,0.15),_transparent_60%)]"></div>
    <div class="max-w-6xl mx-auto px-6 relative">
      <div class="max-w-3xl">
        <span class="inline-block text-blue-400 text-sm font-semibold tracking-widest uppercase mb-4">
          Sales &amp; GTM Consulting
        </span>
        <h1 class="text-5xl md:text-6xl font-extrabold leading-tight tracking-tight mb-6">
          Scale Your Sales.<br />
          <span class="text-blue-400">Accelerate Growth.</span>
        </h1>
        <p class="text-lg md:text-xl text-slate-300 leading-relaxed mb-10 max-w-2xl">
          We work with early-stage companies to build the sales foundations and go-to-market strategies
          that drive predictable, scalable revenue.
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="/services"
            class="px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors"
          >
            Our Services
          </a>
          <a
            href="/contact"
            class="px-6 py-3 bg-white/10 text-white font-semibold rounded-lg hover:bg-white/20 transition-colors border border-white/20"
          >
            Get in Touch
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Value Props -->
  <section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-14">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900">Built for early-stage growth</h2>
        <p class="mt-4 text-slate-500 text-lg max-w-xl mx-auto">
          We bring hands-on expertise to the exact challenges founders face when scaling from zero to a real sales engine.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {[
          {
            icon: '🎯',
            title: 'Sales Strategy',
            desc: 'Define your ideal customer profile, refine your pitch, and build a repeatable sales process that closes deals consistently.',
          },
          {
            icon: '🚀',
            title: 'GTM Execution',
            desc: 'Map your go-to-market motion from channel selection to messaging frameworks — so your team knows exactly how to win.',
          },
          {
            icon: '📈',
            title: 'Revenue Scaling',
            desc: 'Build the playbooks, metrics, and team structures that let you grow revenue without chaos.',
          },
        ].map((item) => (
          <div class="p-8 rounded-2xl bg-slate-50 hover:bg-blue-50 transition-colors group">
            <div class="text-4xl mb-4">{item.icon}</div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">{item.title}</h3>
            <p class="text-slate-500 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Who We Work With -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-blue-600 text-sm font-semibold tracking-widest uppercase">Who We Work With</span>
          <h2 class="mt-3 text-3xl md:text-4xl font-bold text-slate-900 leading-snug">
            Founders ready to stop guessing and start selling
          </h2>
          <p class="mt-4 text-slate-500 leading-relaxed">
            We partner with pre-seed to Series B companies that have product-market fit and are ready to
            professionalize their sales motion. Whether you're making your first sales hire or rebuilding
            a broken process, we've been there.
          </p>
          <a href="/about" class="inline-block mt-6 text-blue-600 font-semibold hover:underline">
            Learn more about us →
          </a>
        </div>
        <div class="grid grid-cols-2 gap-4">
          {[
            { stat: 'Pre-seed to Series B', label: 'Stage Focus' },
            { stat: 'GTM & Sales', label: 'Core Expertise' },
            { stat: 'Fast & Practical', label: 'Our Approach' },
            { stat: 'Hands-on', label: 'Engagement Style' },
          ].map((item) => (
            <div class="p-6 bg-white rounded-xl border border-slate-200 shadow-sm">
              <div class="text-lg font-bold text-slate-900">{item.stat}</div>
              <div class="text-sm text-slate-500 mt-1">{item.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="py-20 bg-blue-600 text-white">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Ready to build your sales engine?</h2>
      <p class="text-blue-100 text-lg mb-8">
        Let's talk about where you are and where you want to go.
      </p>
      <a
        href="/contact"
        class="inline-flex items-center px-8 py-4 bg-white text-blue-600 font-bold rounded-lg hover:bg-blue-50 transition-colors text-lg"
      >
        Start the Conversation
      </a>
    </div>
  </section>

  <Footer />
</Layout>
