---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const services = [
  {
    icon: '🎯',
    title: 'Sales Strategy & ICP Definition',
    desc: 'Clarity on who you sell to and why. We help you define your Ideal Customer Profile, refine your value proposition, and build a sales motion that resonates with the right buyers.',
    items: [
      'ICP and buyer persona development',
      'Value proposition and messaging refinement',
      'Competitive positioning',
      'Sales process design and documentation',
    ],
  },
  {
    icon: '🗺️',
    title: 'Go-to-Market Planning',
    desc: 'A GTM plan that aligns your product, marketing, and sales around a single coherent strategy — built for execution, not presentations.',
    items: [
      'GTM motion selection (PLG, outbound, channel, etc.)',
      'Market segmentation and prioritization',
      'Channel strategy and partnership planning',
      'Launch planning and sequencing',
    ],
  },
  {
    icon: '👥',
    title: 'Sales Team Building & Coaching',
    desc: 'Hiring and developing the right sales talent is one of the hardest things a founder does. We help you get it right the first time.',
    items: [
      'Sales hiring strategy and interview frameworks',
      'Onboarding and ramp planning',
      'Rep and manager coaching',
      'Compensation and quota design',
    ],
  },
  {
    icon: '⚙️',
    title: 'Revenue Operations',
    desc: 'The systems, data, and processes underneath your sales motion. Get the infrastructure that makes forecasting, accountability, and scaling possible.',
    items: [
      'CRM setup and optimization',
      'Pipeline management and forecasting',
      'Sales metrics and KPI frameworks',
      'Playbook and enablement content',
    ],
  },
];
---

<Layout title="Services" description="Sales and GTM consulting services from Sidor Consulting Services.">
  <Nav />

  <!-- Hero -->
  <section class="pt-32 pb-16 bg-slate-900 text-white">
    <div class="max-w-6xl mx-auto px-6">
      <span class="text-blue-400 text-sm font-semibold tracking-widest uppercase">What We Do</span>
      <h1 class="mt-3 text-4xl md:text-5xl font-extrabold leading-tight">
        Services built for<br />
        <span class="text-blue-400">how startups actually work.</span>
      </h1>
      <p class="mt-6 text-slate-300 text-lg max-w-2xl leading-relaxed">
        We offer focused, high-leverage consulting across the four pillars of early-stage
        sales and go-to-market. Every engagement is customized — no retainer bloat, no
        generic deliverables.
      </p>
    </div>
  </section>

  <!-- Services -->
  <section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-8">
        {services.map((service) => (
          <div class="p-8 rounded-2xl border border-slate-200 hover:border-blue-200 hover:shadow-md transition-all group">
            <div class="text-4xl mb-4">{service.icon}</div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">{service.title}</h3>
            <p class="text-slate-500 leading-relaxed mb-5">{service.desc}</p>
            <ul class="space-y-2">
              {service.items.map((item) => (
                <li class="flex items-start gap-2 text-sm text-slate-600">
                  <svg class="w-4 h-4 text-blue-500 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Engagement Models -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-14">
        <span class="text-blue-600 text-sm font-semibold tracking-widest uppercase">Engagement Models</span>
        <h2 class="mt-3 text-3xl md:text-4xl font-bold text-slate-900">Flexible to fit your stage</h2>
        <p class="mt-4 text-slate-500 max-w-xl mx-auto">
          We structure engagements around your needs — not a one-size-fits-all retainer.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {[
          {
            title: 'Sprint',
            duration: '2–4 weeks',
            desc: 'Focused diagnostic and strategy work for a specific challenge — ICP, GTM plan, or sales process redesign.',
          },
          {
            title: 'Embedded',
            duration: '1–3 months',
            desc: 'Ongoing advisory and execution support as a fractional sales leader or GTM advisor alongside your team.',
          },
          {
            title: 'Advisory',
            duration: 'Ongoing',
            desc: 'Regular strategic sessions for founders or sales leaders who want a trusted sounding board and accountability partner.',
          },
        ].map((model) => (
          <div class="bg-white rounded-xl p-8 border border-slate-200 shadow-sm text-center">
            <h3 class="text-xl font-bold text-slate-900">{model.title}</h3>
            <div class="text-blue-600 font-semibold text-sm mt-1 mb-4">{model.duration}</div>
            <p class="text-slate-500 text-sm leading-relaxed">{model.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-blue-600 text-white">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-3xl font-bold mb-4">Not sure where to start?</h2>
      <p class="text-blue-100 mb-8">
        Let's talk through your situation. Most engagements start with a simple conversation.
      </p>
      <a
        href="/contact"
        class="inline-flex items-center px-8 py-4 bg-white text-blue-600 font-bold rounded-lg hover:bg-blue-50 transition-colors text-lg"
      >
        Let's Talk
      </a>
    </div>
  </section>

  <Footer />
</Layout>
